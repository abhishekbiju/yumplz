<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Group for shared container with main app.
         Requires paid Apple Developer account for real device provisioning.
         Works in simulator without provisioning profile. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.abhishekbiju.yumplz</string>
    </array>
</dict>
</plist>
